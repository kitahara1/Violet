<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="@string/enter_pin"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="26sp" />

    <!-- Error / Subtitle -->
    <TextView
        android:id="@+id/tv_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#E51400"
        android:textSize="14sp"
        android:visibility="invisible" />

    <!-- 4 PIN Indicator Dots -->
    <LinearLayout
        android:id="@+id/ll_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot_empty" />

    </LinearLayout>

    <!-- 3x4 Metro Keypad -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <TableRow android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btn_num_1"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_num_2"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="2"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_num_3"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="3"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btn_num_4"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="4"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_num_5"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="5"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_num_6"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="6"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btn_num_7"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="7"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_num_8"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="8"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_num_9"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="9"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
        </TableRow>

        <TableRow>
            <Button
                android:id="@+id/btn_keypad_cancel"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="cancel"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btn_num_0"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="0"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24sp" />
            <Button
                android:id="@+id/btn_keypad_backspace"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="⌫"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp" />
        </TableRow>

    </TableLayout>

</LinearLayout>
