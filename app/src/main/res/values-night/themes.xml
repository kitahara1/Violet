<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark Mode - Pure Black) with transparent system bars. -->
    <style name="Theme.Violet" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/wp_violet</item>
        <item name="colorSecondary">@color/wp_violet</item>
        <item name="android:windowBackground">@color/wp_dark_background</item>
        <item name="android:textColorPrimary">@color/wp_dark_text_primary</item>
        <item name="android:textColorSecondary">@color/wp_dark_text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
